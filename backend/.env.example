# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (Must be a MySQL host, not an HTTP REST endpoint)
DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=transport_db
DB_SSL=true

# Security & CORS
JWT_SECRET=your_super_strong_random_jwt_secret_at_least_32_characters
FRONTEND_URL=https://srimuruganrigservice.netlify.app
